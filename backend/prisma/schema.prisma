generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id        String   @id @default(cuid())
  rcNumber  String?   @unique
  name      String
  phone     String?
  address   String?
  shop_no   Int?
  aadhar    String?
  kgs       Float?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
